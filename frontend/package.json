{
  "name": "fooyre-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "FOOYRE — application web (SPA React). Socle technique de la phase 1.",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "browserslist": [
    "chrome >= 87",
    "edge >= 88",
    "firefox >= 78",
    "safari >= 14",
    "ios_saf >= 14"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/verify-build.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:build": "node scripts/verify-build.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@tanstack/react-query": "5.107.1",
    "axios": "1.21.1",
    "i18next": "26.7.2",
    "lucide-react": "1.71.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.13",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "autoprefixer": "10.6.2",
    "eslint": "10.15.0",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "msw": "3.0.7",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "tailwindcss": "3.4.19",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
