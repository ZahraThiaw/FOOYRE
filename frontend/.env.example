# =====================================================================
# FOOYRE — Configuration du FRONTEND (valeurs d'exemple)
# Copier en frontend/.env.local pour le développement. Ne jamais commiter .env.local.
#
# ATTENTION : toute variable VITE_* est PUBLIQUE (intégrée au code livré aux navigateurs).
# Aucun secret ici : pas de clé API, pas de mot de passe, pas de secret JWT.
# La configuration du backend et de l'infrastructure se trouve dans le .env.example racine.
# =====================================================================

# Préfixe de l'API (même domaine que le frontend en production)
VITE_API_BASE_URL=/api/v1

# Données fictives (MSW) : serveur de développement uniquement.
# Le build de production échoue si cette variable vaut true.
VITE_ENABLE_MOCKS=false
