# =====================================================================
# FOOYRE — Exemple de configuration (valeurs FICTIVES uniquement)
# Copier en .env pour le développement local. Ne jamais commiter .env.
# En production, injecter ces variables via le gestionnaire de secrets.
# =====================================================================

# --- Application ---
SPRING_PROFILES_ACTIVE=dev
APP_PUBLIC_BASE_URL=http://localhost:5173
APP_DEFAULT_TIMEZONE=Africa/Dakar
APP_DEFAULT_CURRENCY=XOF
SERVER_PORT=8080

# --- PostgreSQL ---
# Développement local (MVP-0) : `docker compose up -d` (racine) lit ce fichier sous le nom .env ;
# le profil Spring `dev` le lit aussi (backend lancé depuis backend/). Valeurs FICTIVES : à changer
# hors de la machine locale. Les rôles ne sont créés qu'au PREMIER démarrage (volume vide).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fooyre
# Rôle propriétaire du schéma (utilisé par Flyway uniquement)
POSTGRES_MIGRATION_USER=fooyre_owner
POSTGRES_MIGRATION_PASSWORD=change-me-owner-password
# Rôle applicatif (non propriétaire, soumis à la RLS)
POSTGRES_APP_USER=fooyre_app
POSTGRES_APP_PASSWORD=change-me-app-password
# Superutilisateur de l'image Docker : administration uniquement, jamais utilisé par l'application
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser-password

# --- Authentification (JWT + refresh token en cookie HttpOnly) ---
# Doit faire au moins 32 octets aléatoires encodés en base64 en production.
JWT_SECRET=REPLACE_WITH_BASE64_RANDOM_SECRET_AT_LEAST_32_BYTES
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=30
# Fenêtre de tolérance (secondes) pour les rafraîchissements simultanés de plusieurs onglets
AUTH_REFRESH_REUSE_GRACE_SECONDS=10
# false uniquement en développement local (HTTP). L'application refuse de démarrer en prod si false.
AUTH_COOKIE_SECURE=false

# --- Compte de démonstration (profil Spring dev UNIQUEMENT, MVP-1) ---
# Crée au démarrage, s'il n'existe pas, le compte propriétaire demo@fooyre.local et l'entreprise
# « FOOYRE Commerce Démo ». Laisser vide pour ne rien créer. Au moins 12 caractères ; à choisir
# localement (jamais de valeur réelle ici). Un compte existant n'est jamais modifié.
FOOYRE_DEMO_OWNER_PASSWORD=
# Second compte propriétaire de démonstration (profil dev UNIQUEMENT), indépendant du premier :
# entreprise « Nafi Chic » d'Aminata Sarr. Laisser le mot de passe vide pour ne rien créer ;
# au moins 12 caractères, à choisir localement (jamais de valeur réelle ici).
# FOOYRE_DEMO2_OWNER_EMAIL=aminata.demo@fooyre.local
# FOOYRE_DEMO2_OWNER_FULL_NAME=Aminata Sarr
# FOOYRE_DEMO2_BUSINESS_NAME=Nafi Chic
FOOYRE_DEMO2_OWNER_PASSWORD=
# Adresse d'écoute du backend en profil dev (boucle locale par défaut).
# SERVER_ADDRESS=127.0.0.1

# --- Accès support de l'administrateur plateforme ---
SUPPORT_ACCESS_MAX_DURATION_HOURS=4

# --- CORS (développement uniquement ; inutile si même domaine en production) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Intelligence artificielle (Anthropic Claude) — backend uniquement ---
# Interrupteur global. Désactivé par défaut.
AI_ENABLED=false
# Garde-fou de production : tant que false, l'IA reste désactivée en profil prod
# (aucune donnée transmise à Anthropic), même si AI_ENABLED=true. À passer à true
# uniquement après obtention des validations juridiques et réglementaires, notamment
# auprès de la CDP et pour les transferts internationaux de données.
AI_PRODUCTION_APPROVED=false
# Fournisseur : "fake" (développement / tests) ou "anthropic"
AI_PROVIDER=fake
# Valeur fictive : la vraie clé n'existe que dans le gestionnaire de secrets / le .env local.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME_FAKE_KEY
# Modèle par défaut : Claude Opus 5.5 (identifiant relevé le 2026-11-18 sur la doc officielle,
# à revérifier avant implémentation).
ANTHROPIC_MODEL=claude-opus-5-5
# Profondeur de réflexion (low | medium | high | xhigh | max) — à ajuster en phase 9
ANTHROPIC_EFFORT=medium
ANTHROPIC_MAX_TOKENS=16000
ANTHROPIC_TIMEOUT_SECONDS=120
ANTHROPIC_MAX_RETRIES=2
# Plafond de dépense mensuel global (USD) au-delà duquel l'IA est coupée (valeur d'exemple)
AI_GLOBAL_MONTHLY_BUDGET_USD=50
# Grille de prix pour l'ESTIMATION des coûts (USD par million de jetons).
# Tarifs Claude Opus 5.5 relevés le 2026-11-18 (platform.claude.com, pricing) — à revérifier.
AI_PRICE_TABLE_VERSION=2026-11-18
AI_PRICE_INPUT_PER_MTOK_USD=4.00
AI_PRICE_OUTPUT_PER_MTOK_USD=20.00
AI_PRICE_CACHE_READ_PER_MTOK_USD=0.20
AI_PRICE_CACHE_WRITE_PER_MTOK_USD=5.00

# --- Limitation de débit ---
# Connexion (MVP-1.1, compteurs PostgreSQL) : échecs tolérés dans la fenêtre, puis blocage
# temporaire. Réponse 429 RATE_LIMITED + Retry-After, identique que le compte existe ou non.
# (Remplace RATE_LIMIT_LOGIN_PER_MINUTE, jamais utilisée.)
LOGIN_THROTTLE_MAX_FAILURES_PER_ACCOUNT_AND_IP=5
LOGIN_THROTTLE_MAX_FAILURES_PER_ACCOUNT=20
LOGIN_THROTTLE_MAX_FAILURES_PER_IP=50
LOGIN_THROTTLE_WINDOW_MINUTES=15
LOGIN_THROTTLE_BLOCK_MINUTES=15
LOGIN_THROTTLE_RETENTION_HOURS=24
LOGIN_THROTTLE_CLEANUP_INTERVAL_MINUTES=60
RATE_LIMIT_PUBLIC_STOREFRONT_PER_MINUTE=60
RATE_LIMIT_ORDER_REQUEST_PER_HOUR=10

# --- Email / SMS (canal de réinitialisation à valider) ---
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com

# --- Frontend ---
# La configuration du frontend (variables publiques VITE_*) se trouve dans frontend/.env.example.
# Ne jamais y copier une valeur de ce fichier : il contient des secrets backend.
